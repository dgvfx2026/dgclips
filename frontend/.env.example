# The UI works in demo mode without credentials.
# Set DGCLIPS_DEMO=false after configuring every production service below.
DGCLIPS_DEMO=true
NEXT_PUBLIC_SELF_HOST=true
# NEXT_PUBLIC_SOURCE_URL=https://github.com/dgvfx2026/dgclips
NEXT_PUBLIC_APP_URL=http://localhost:3107
BETTER_AUTH_URL=http://localhost:3107

# Production: use the SAME database as the backend, with a Prisma-compatible URL.
# DATABASE_URL=postgresql://user:password@database-host:5432/dgclips?sslmode=require
# BETTER_AUTH_SECRET=generate-a-unique-secret-with-at-least-32-characters
# BACKEND_AUTH_SECRET=generate-another-secret-and-use-it-on-the-backend-too
# APP_SETTINGS_ENCRYPTION_KEY=generate-a-third-secret-and-share-it-with-the-backend
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# BACKEND_INTERNAL_URL=https://api.your-domain.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-project.vercel.app

# Create the first account, then set this to true for a personal-only workspace.
DISABLE_SIGN_UP=false
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES=4000000000
