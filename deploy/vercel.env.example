# Add these to the Vercel project. Do not commit real values.
# Project Root Directory: repository root (.), not frontend/.
DGCLIPS_DEMO=true
NEXT_PUBLIC_SELF_HOST=true
NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app
BETTER_AUTH_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_SOURCE_URL=https://github.com/dgvfx2026/dgclips

# Required to switch DGCLIPS_DEMO=false after external services are ready.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dgclips?sslmode=require
BACKEND_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/dgclips?ssl=require
BETTER_AUTH_SECRET=GENERATE_A_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS
BACKEND_AUTH_SECRET=GENERATE_ANOTHER_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS
APP_SETTINGS_ENCRYPTION_KEY=GENERATE_A_THIRD_SECRET_AT_LEAST_32_CHARACTERS
REDIS_HOST=YOUR-TCP-REDIS-HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR-REDIS-PASSWORD
REDIS_SSL=true
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=YOUR-PRIVATE-BUCKET
MEDIA_S3_REGION=YOUR-REGION
MEDIA_S3_ENDPOINT=https://YOUR-S3-ENDPOINT
MEDIA_S3_ACCESS_KEY_ID=YOUR-STORAGE-ACCESS-KEY
MEDIA_S3_SECRET_ACCESS_KEY=YOUR-STORAGE-SECRET
ASSEMBLY_AI_API_KEY=YOUR-TRANSCRIPTION-KEY
LLM=YOUR-SUPPORTED-PROVIDER-AND-MODEL
OPENAI_API_KEY=YOUR-MODEL-KEY-IF-USING-OPENAI
SELF_HOST=true
DISABLE_SIGN_UP=false

# DO NOT manually set DGCLIPS_BACKEND_URL or SUPOCLIP_API_URL.
# Vercel injects them from service bindings at runtime.
