# Copy to the REPOSITORY ROOT as .env. Do not commit the resulting file.
API_DOMAIN=api.your-domain.com
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
CORS_ORIGINS=https://your-project.vercel.app
SELF_HOST=true
BACKEND_AUTH_SECRET=replace-with-the-same-backend-secret-as-vercel
APP_SETTINGS_ENCRYPTION_KEY=replace-with-the-same-encryption-key-as-vercel

# External PostgreSQL shared with Vercel. Asyncpg uses ssl=require, NOT sslmode.
# Remove provider-specific Prisma-only query parameters such as pgbouncer.
BACKEND_DATABASE_URL=postgresql+asyncpg://user:password@database-host:5432/dgclips?ssl=require
REDIS_PASSWORD=replace-with-a-long-random-password

ASSEMBLY_AI_API_KEY=replace-with-your-transcription-key
LLM=openai:gpt-4o-mini
OPENAI_API_KEY=replace-with-your-model-key
TRANSCRIPTION_PROVIDER=assemblyai
TRANSCRIPTION_LANGUAGE=pt

# Object storage keeps large upload/download bodies outside Vercel functions.
# Use a private S3-compatible bucket and configure CORS (deploy/storage-cors.json).
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=dgclips-private
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=https://your-s3-compatible-endpoint
MEDIA_S3_ACCESS_KEY_ID=replace-with-your-storage-access-key
MEDIA_S3_SECRET_ACCESS_KEY=replace-with-your-storage-secret
MEDIA_URL_TTL_SECONDS=900
MAX_VIDEO_UPLOAD_BYTES=4000000000
TEMP_DIR=/app/uploads
DEFAULT_PROCESSING_MODE=fast
MAX_CLIPS=10
FAST_MODE_MAX_CLIPS=10
SOCIAL_PUBLISHING_ACCESS=off
